# Alpaca Markets API credentials
# Sign up free at https://alpaca.markets — no deposit required
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Database (SQLite, no setup needed)
DATABASE_URL=sqlite:///./bmg_capital.db

# Frontend origin for CORS
CORS_ORIGINS=http://localhost:5173

# Optional: Financial Modeling Prep API key (for earnings calendar)
# Free tier: 250 req/day — sign up at https://financialmodelingprep.com
FMP_API_KEY=

# Optional: AI key for "Explain This" feature (falls back to curated glossary if omitted)
# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI (GPT-4o-mini): https://platform.openai.com
OPENAI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
