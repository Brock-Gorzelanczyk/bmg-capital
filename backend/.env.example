# ═══════════════════════════════════════════════════════════════
# BMG Capital — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
ENVIRONMENT=production
APP_URL=https://your-railway-domain.railway.app
PORT=8000
HOST=0.0.0.0

# ── Auth (REQUIRED) ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-32-byte-hex-string

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./bmg_capital.db

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# APP_URL is always included automatically
CORS_ORIGINS=["https://your-frontend-domain.railway.app"]

# ── Market Data ───────────────────────────────────────────────
# Alpaca — free at https://alpaca.markets (no deposit required)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── AI Features ───────────────────────────────────────────────
# Required for TA Workshop and Copilot features
ANTHROPIC_API_KEY=
# Optional — used for explain + support chat
OPENAI_API_KEY=

# ── Payments (optional — only needed for subscriptions) ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=

# ── Plaid (optional — for linked brokerage accounts) ──────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Observability (optional) ──────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Demo Mode (optional) ──────────────────────────────────────
# Credentials for the auto-login demo account
RESTORE_SECRET=

# ── Seeding Guard (never set in production) ───────────────────────────────
# scripts/backfill_bot_data.py inserts fake paper-trade history for dev/demo.
# It is BLOCKED when RAILWAY_ENVIRONMENT=production (set automatically by Railway).
# To override for a deliberate production re-seed (DANGER):
# FORCE_SEED=1
