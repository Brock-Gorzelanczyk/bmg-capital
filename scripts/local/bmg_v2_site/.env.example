# Alpaca Market Data v2 API credentials for daily_prices.py.
#
# Paper account keys work fine for market data. Sign up (free, no deposit) at:
#   https://app.alpaca.markets
#
# Copy this file to `.env` and populate. `daily_prices.py` reads it
# automatically. The `.env` file is gitignored — never commit real keys.
#
# Two naming conventions are accepted:
#   - Official Alpaca SDK names (APCA_*)
#   - Repo-wide aliases used in backend/.env (ALPACA_*)
# If both are set, APCA_* wins.

APCA_API_KEY_ID=PK_your_key_id_here
APCA_API_SECRET_KEY=your_secret_key_here

# Or:
# ALPACA_API_KEY=PK_your_key_id_here
# ALPACA_SECRET_KEY=your_secret_key_here
